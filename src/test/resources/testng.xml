<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FalconQA Complete Test Suite" verbose="1" parallel="false" thread-count="3">
    
    <!-- Custom Listeners for Enhanced Reporting and Retry -->
    <listeners>
        <listener class-name="com.falconqa.listeners.TestListener"/>
    </listeners>
    
    <!-- Test: Login Tests (Original) -->
    <test name="Login Tests" preserve-order="true">
        <classes>
            <class name="com.falconqa.tests.LoginTests"/>
        </classes>
    </test>
    
    <!-- Test: Login Data-Driven Tests (Excel) -->
    <test name="Login Data-Driven Tests (Excel)" preserve-order="true">
        <classes>
            <class name="com.falconqa.tests.LoginDataDrivenTests"/>
        </classes>
    </test>
    
    <!-- Test: Product Tests -->
    <test name="Product Tests" preserve-order="true">
        <classes>
            <class name="com.falconqa.tests.ProductTests"/>
        </classes>
    </test>
    
    <!-- Test: Cart Tests -->
    <test name="Cart Tests" preserve-order="true">
        <classes>
            <class name="com.falconqa.tests.CartTests"/>
        </classes>
    </test>
    
    <!-- Test: Checkout Tests (Original) -->
    <test name="Checkout Tests" preserve-order="true">
        <classes>
            <class name="com.falconqa.tests.CheckoutTests"/>
        </classes>
    </test>
    
    <!-- Test: Checkout Data-Driven Tests (JSON) -->
    <test name="Checkout Data-Driven Tests (JSON)" preserve-order="true">
        <classes>
            <class name="com.falconqa.tests.CheckoutDataDrivenTests"/>
        </classes>
    </test>
    
</suite>
